{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm run build)",
			"Bash(npm run dev)",
			"Bash(npm run release)",
			"Bash(npm run lint)",
			"Bash(npm install)",
			"Bash(npx tsc --noEmit)",
			"Bash(npx biome check:*)",
			"Bash(npx vitest:*)",
			"Bash(npx ait:*)",
			"Bash(ax:*)"
		]
	},
	"enableAllProjectMcpServers": true
}
