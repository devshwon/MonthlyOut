{
  "name": "monthlyout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:web": "vite --port 5179 --host",
    "build": "vite build && ait build",
    "preview": "vite preview",
    "deploy": "ait deploy --api-key __PUT_YOUR_CONSOLE_API_KEY__",
    "release": "npm run build && npx ait deploy --profile devshwon",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.7.0",
    "@toss/tds-mobile": "^2.5.1",
    "@toss/tds-mobile-ait": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "^3.7.0",
    "@biomejs/biome": "latest",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
